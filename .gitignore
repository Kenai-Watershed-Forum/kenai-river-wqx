# Excludes the following files from synching to GitHub:

#.Rproj.user
.Rhistory
.RData
.RDataTmp*
.Ruserdata

/.quarto/

.Rproj.user

# these files downloaded from WQP are too large to sync
other/input/WQX_downloads

/other/epa_cdx.txt
.posit/assistant

**/*.quarto_ipynb

# Windows NUL device — accidentally surfaced as a filesystem entry by a bash
# redirect (2>nul) in a tool call; cannot be deleted, must be ignored.
/nul

# knitr chunk caches and figure assets — regenerated on render
*_cache/
*_files/
# Exception: agent context files are not render output
!other/agent_context/context_files/

# Rendered book output - published via `quarto publish gh-pages`
# (pushes to the gh-pages branch), never committed on main.
/docs/
/README.html
/appendix_a.html
